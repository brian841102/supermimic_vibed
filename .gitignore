# caches and build output
.cache/
__pycache__/
*.pyc
build_*.log
# upstream checkout (pinned commit cloned by tools/setup.sh)
IsaacLab/
# third-party data (downloaded by tools/download_data.sh) and generated assets
data/
# training runs: checkpoints, logs
logs/
*.pt
# rendered videos and recorded trajectories (derived from CC BY-NC-ND LAFAN1 motions)
*.mp4
*.npz
results/analysis/
# third-party paper
*.pdf

# retarget: videos / estimation results / rendered videos are never committed (copyright, size).
# retarget/assets/ is committed; retarget/third_party/{GVHMR,GMR} are submodules.
retarget/data/
retarget/third_party/.ytdlp/
retarget/third_party/*.log
