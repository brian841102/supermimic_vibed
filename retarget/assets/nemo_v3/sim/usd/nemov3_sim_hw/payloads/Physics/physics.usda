                            float physics:lowerLimit = -9.998114
                            float physics:upperLimit = 60.00014
                        }
                    }

                    def PhysicsRevoluteJoint "left_hip_pitch_joint" (
                        prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    )
                    {
                        float newton:armature = 0.01
                        uniform token physics:axis = "Y"
                        custom rel physics:body0
                        append rel physics:body0 = </nemov3_sim_hw/Geometry/link_leg2pelvis/leg_base_link>
                        custom rel physics:body1
                        append rel physics:body1 = </nemov3_sim_hw/Geometry/link_leg2pelvis/leg_base_link/left_hip_pitch_link>
                        point3f physics:localPos0 = (0, 0.03, -0.0069101)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                        float physics:lowerLimit = -90.00021
                        float physics:upperLimit = 90.00021
                    }
                }

                def PhysicsFixedJoint "PhysicsFixedJoint"
                {
                    custom rel physics:body0
                    append rel physics:body0 = </nemov3_sim_hw/Geometry/link_leg2pelvis>
                    custom rel physics:body1
                    append rel physics:body1 = </nemov3_sim_hw/Geometry/link_leg2pelvis/leg_base_link>
                    point3f physics:localPos0 = (0, 0, -0.09)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
            float physics:staticFriction = 1
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI"]
)
{
    uniform int newton:maxSolverIterations = 100
    uniform int newton:timeStepsPerSecond = 500
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}

